class Solution:
    def maximumSum(self, mat, k):
        # code here
        
        row=len(mat)
        
        col=len(mat[0])
        
        pref=[[0]*col for _ in range(row)]
        
       
        for i in range(row):
            
            for j in range(col):
                
                
                pref[i][j]=mat[i][j]
                
                if i>0:
                    pref[i][j]+=pref[i-1][j]
                    
                if j>0:
                    pref[i][j]+=pref[i][j-1]
                    
                if i>0 and j>0:
                    pref[i][j]-=pref[i-1][j-1]
                    
        
        
        ans=float("-inf")
        
        for i in range(row-k+1):
            for j in range(col-k+1):
                
                r2=i+k-1
                c2=j+k-1
                
                sum=pref[r2][c2]
                
                if i>0:
                    sum-=pref[i-1][c2]
                    
                if j>0:
                    sum-=pref[r2][j-1]
                    
                if i>0 and j>0:
                    sum+=pref[i-1][j-1]
                    
                ans=max(ans,sum)
                
        return ans
                
                
        
